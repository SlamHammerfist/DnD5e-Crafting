<div class="craft-body">

    {{!-- Coins and tools --}}
    <section class="craft-summary">
        <div class="craft-summary-group">
            <span class="craft-summary-label">{{ localize "DND5ECRAFT.Wealth" }}</span>
            <ul class="pills">
                {{#each coins}}
                <li class="pill coin">
                    <i class="currency {{ key }}" style="background-image: url('{{ icon }}')" data-tooltip
                       aria-label="{{ label }}"></i>
                    {{ count }}
                </li>
                {{else}}
                <li class="pill transparent">{{ localize "DND5ECRAFT.Free" }}</li>
                {{/each}}
            </ul>
        </div>
        <div class="craft-summary-group tools">
            <span class="craft-summary-label">{{ localize "DND5ECRAFT.Tools" }}</span>
            <ul class="pills">
                {{#each toolNames}}<li class="pill">{{ this }}</li>{{else}}<li class="pill transparent">{{ localize "DND5ECRAFT.NoTools" }}</li>{{/each}}
            </ul>
        </div>
    </section>

    <nav class="tabs sheet-tabs craft-tabs" role="tablist">
        {{#each tabs}}
        <a class="item {{#if active}}active{{/if}}" role="tab" aria-selected="{{ active }}" data-action="switchTab"
           data-tab="{{ id }}">
            <span><i class="{{ icon }}" inert></i> {{ localize label }}{{#if count}} <span class="count">{{ count }}</span>{{/if}}</span>
        </a>
        {{/each}}
    </nav>

    {{!-- Projects --}}
    {{#if (eq tab "projects")}}
    <div class="craft-scroll">
        <fieldset class="card">
            <legend>{{ localize "DND5ECRAFT.InProgress" }}</legend>
            {{#each activeProjects}}{{> "dnd5e-crafting.project" }}{{else}}
            <p class="empty">{{ localize "DND5ECRAFT.NoProjects" }}</p>
            {{/each}}
        </fieldset>

        {{#if finishedProjects.length}}
        <fieldset class="card finished">
            <legend>{{ localize "DND5ECRAFT.Finished" }}</legend>
            {{#each finishedProjects}}{{> "dnd5e-crafting.project" }}{{/each}}
            <button type="button" class="craft-clear" data-action="clearFinished">
                <i class="fa-solid fa-broom" inert></i> {{ localize "DND5ECRAFT.ClearFinished" }}
            </button>
        </fieldset>
        {{/if}}
    </div>
    {{/if}}

    {{!-- New Project --}}
    {{#if (eq tab "new")}}
    <div class="craft-filter">
        <input type="search" name="search" value="{{ search }}" placeholder="{{ localize "DND5ECRAFT.Search" }}"
               aria-label="{{ localize "DND5ECRAFT.Search" }}">
        <label class="checkbox">
            <input type="checkbox" data-action="toggleAll" {{ checked showAll }}>
            {{ localize "DND5ECRAFT.ShowAll" }}
        </label>
    </div>
    <div class="craft-scroll craft-catalog">
        <fieldset class="card">
            <legend>{{ localize "DND5ECRAFT.Catalog" }}</legend>
            {{#each entries}}
            <div class="craft-row {{#unless ok}}disabled{{/unless}}" data-uuid="{{ uuid }}" data-search="{{ search }}">
                <img class="gold-icon" src="{{ img }}" alt="" data-item-uuid="{{ uuid }}">
                <div class="craft-info">
                    <div class="craft-name" data-item-uuid="{{ uuid }}">
                        {{ name }}{{#if rarity}} <span class="rarity">{{ rarity }}</span>{{/if}}
                    </div>
                    {{#if ok}}
                    <ul class="pills">
                        {{#each tools}}<li class="pill">{{ this }}</li>{{/each}}
                        <li class="pill transparent"><i class="fa-solid fa-coins" inert></i> {{ cost }}</li>
                        <li class="pill transparent"><i class="fa-solid fa-calendar-day" inert></i> {{ days }} {{ localize "DND5ECRAFT.Workdays" }}</li>
                    </ul>
                    {{else}}
                    <div class="craft-reason">{{ reason }}</div>
                    {{/if}}
                </div>
                {{#if ok}}
                <div class="craft-controls">
                    <button type="button" class="gold-button" data-action="start"
                            data-tooltip="DND5ECRAFT.Start.Short" aria-label="{{ localize "DND5ECRAFT.Start.Short" }}">
                        <i class="fa-solid fa-hammer" inert></i>
                    </button>
                </div>
                {{/if}}
            </div>
            {{/each}}
            <p class="empty craft-catalog-empty" {{#if entries.length}}hidden{{/if}}>
                {{#if hasTools}}{{ localize "DND5ECRAFT.NoMatches" }}{{else}}{{ localize "DND5ECRAFT.NoTools" }}{{/if}}
            </p>
        </fieldset>
    </div>
    {{/if}}

    {{!-- Fast Crafting --}}
    {{#if (eq tab "fast")}}
    <div class="craft-scroll craft-fast">
        <p class="hint">{{ localize "DND5ECRAFT.Fast.Hint" }}</p>
        {{#if fast.enabled}}
        {{#if fast.used}}
        <p class="craft-note"><i class="fa-solid fa-moon" inert></i> {{ localize "DND5ECRAFT.Fast.Used" }}</p>
        {{else}}
        {{#each fast.options}}
        <fieldset class="card">
            <legend>{{ label }}</legend>
            <div class="fast-items">
                {{#each items}}
                <button type="button" class="fast-item" data-action="fastCraft" data-tool="{{ ../tool }}"
                        data-key="{{ key }}" data-name="{{ name }}" {{#if uuid}}data-item-uuid="{{ uuid }}"{{/if}}>
                    <img class="gold-icon" src="{{ img }}" alt=""> {{ name }}
                </button>
                {{/each}}
            </div>
        </fieldset>
        {{else}}
        <p class="craft-note">{{ localize "DND5ECRAFT.Fast.NoTools" }}</p>
        {{/each}}
        {{/if}}
        {{else}}
        <p class="craft-note">{{ localize "DND5ECRAFT.Fast.NeedFeat" }}</p>
        {{/if}}

        {{#if fast.held.length}}
        <fieldset class="card">
            <legend>{{ localize "DND5ECRAFT.Fast.Held" }}</legend>
            {{#each fast.held}}
            <div class="craft-row" data-item-uuid="{{ uuid }}">
                <img class="gold-icon" src="{{ img }}" alt="">
                <div class="craft-info"><div class="craft-name">{{ name }}</div></div>
            </div>
            {{/each}}
        </fieldset>
        {{/if}}
    </div>
    {{/if}}

</div>
